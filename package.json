{
  "name": "gittree",
  "version": "1.0.0",
  "description": "代码年轮 - 用树形可视化展示 Git 仓库的提交历史",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:forest": "node scripts/forest-test.mjs",
    "test:music": "node scripts/music-test.mjs",
    "test:export": "node scripts/export-test.mjs",
    "test:interaction": "node scripts/interaction-test.mjs",
    "test:visual": "node scripts/visual-test.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "shot:crown": "node scripts/crown-shot.mjs",
    "demo:record": "node scripts/demo-record.mjs",
    "demo:subtitle": "node scripts/demo-subtitle.mjs",
    "demo:probe": "node scripts/demo-probe.mjs",
    "doc:pdf": "node scripts/doc-to-pdf.mjs"
  },
  "keywords": [
    "git",
    "visualization",
    "tree",
    "github"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dongfangzhizhu/gittree.git"
  },
  "homepage": "https://github.com/dongfangzhizhu/gittree",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
